# sub2api-panel 后端配置示例
# 复制为 config.yaml 并按需修改

server:
  # 监听地址
  addr: ":8088"
  # 时区，用于"今日"、"近7天"按本地时间分桶
  timezone: "Asia/Shanghai"
  # SSE 推送间隔（秒）
  sse_interval_seconds: 5
  # 统计结果内存缓存时长（秒，避免高频查询打爆数据库）
  cache_ttl_seconds: 5
  # 排行榜返回前 N 条
  top_n: 20
  # 账号监控展示哪个分组下的账号（填该分组在 sub2api 数据库的 group_id）
  # 例如 plus 分组的 id。设为 0 表示不展示账号监控。
  account_monitor_group_id: 0

# PostgreSQL 连接信息（连接的是 sub2api 同一个库，只读使用）
database:
  host: "127.0.0.1"
  port: 5432
  user: "sub2api"
  password: "your_password"
  dbname: "sub2api"
  sslmode: "require"
  max_open_conns: 10
  max_idle_conns: 5
  conn_max_lifetime_minutes: 30

log:
  level: "info"   # debug / info / warn / error
